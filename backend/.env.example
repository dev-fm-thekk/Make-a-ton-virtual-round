# ---- App ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Runtime connection (app traffic).
#   local:    postgresql://postgres:postgres@localhost:5432/subscriptions
#   supabase: the *transaction pooler* string (port 6543), append ?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/subscriptions

# Direct connection used ONLY by `prisma migrate` (DDL needs a session connection).
#   local:    same as DATABASE_URL
#   supabase: the *direct* / session-pooler string (port 5432)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/subscriptions

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# ---- Links in emails ----
APP_BASE_URL=http://localhost:3000

# ---- Email (nodemailer) ----
# Leave SMTP_HOST empty in dev: emails are printed to the API log instead of sent.
# Required in production. Gmail example: smtp.gmail.com / 587 / app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brightloop Billing <no-reply@yourdomain.com>"

# ---- Seed (npm run db:seed) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!12345
ADMIN_NAME=Administrator
