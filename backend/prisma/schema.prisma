// Subscription Management System — data model.
//
// Conventions
//  * Primary keys: UUID (generated by Postgres, no hot sequence, safe to expose).
//  * Money: NUMERIC(12,2). Tax / percentage rates: NUMERIC(5,2). Never floats.
//  * Every table has createdAt/updatedAt (timestamptz). Master data is soft-deleted (deletedAt).
//  * Invoices & invoice lines are IMMUTABLE SNAPSHOTS of price/tax/discount at billing time.
//  * Rules Prisma cannot express (partial unique indexes, CHECK constraints, partial
//    indexes) live in prisma/migrations/*_constraints_and_indexes/migration.sql.

generator client {
  provider        = "prisma-client"
  // one JOINed query instead of one query per relation (the billing engine loads a subscription graph per invoice)
  previewFeatures = ["relationJoins"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SERVICE
  GOODS
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Draft → Quotation → Confirmed → Active → Closed (Paused is a reversible side state of Active)
enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

/// Draft → Confirmed → Paid. Cancelled is terminal. "Overdue" is derived (CONFIRMED && dueDate < today).
enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT // applies to lines of the listed products
  SUBSCRIPTION // applies to whole subscriptions it is attached to
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  OTHER
}

enum BillingRunStatus {
  RUNNING
  COMPLETED
  PARTIAL // finished, some subscriptions failed
  FAILED
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lowercase (CHECK constraint enforces it) → case-insensitive uniqueness.
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  customer            Customer?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  subscriptionsCreated   Subscription[]              @relation("SubscriptionCreatedBy")
  subscriptionStatusLogs SubscriptionStatusHistory[]
  paymentsRecorded       Payment[]

  @@index([role, isActive])
  @@map("users")
}

/// Rotating refresh tokens. Only the SHA-256 hash is stored. `familyId` enables
/// reuse detection: replaying a revoked token revokes the whole family.
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  familyId   String    @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  replacedBy String?   @db.Uuid
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// The billed party. A customer may be managed by staff before they ever sign in
/// (userId is nullable until a portal account is linked).
model Customer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?   @unique @db.Uuid
  name           String
  companyName    String?
  email          String
  phone          String?
  taxId          String?
  billingAddress Json? // {line1,line2,city,state,postalCode,country}
  notes          String?
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([email])
  @@index([name])
  @@map("customers")
}

// ───────────────────────── Catalog ─────────────────────────

model Tax {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique among live rows, case-insensitively (partial index in the *_tax_name_live_unique migration).
  name        String
  /// Percentage, e.g. 18.00
  ratePercent Decimal   @db.Decimal(5, 2)
  isActive    Boolean   @default(true)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  products          Product[]
  subscriptionLines SubscriptionLine[]

  @@map("taxes")
}

model Product {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  type       ProductType
  salesPrice Decimal     @db.Decimal(12, 2)
  costPrice  Decimal     @db.Decimal(12, 2)
  notes      String?
  /// Default tax applied to this product on new subscription lines.
  taxId      String?     @db.Uuid
  isActive   Boolean     @default(true)
  deletedAt  DateTime?   @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  tax      Tax?             @relation(fields: [taxId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  discountProducts  DiscountProduct[]

  @@index([name])
  @@index([isActive, deletedAt])
  @@map("products")
}

/// e.g. attribute="Brand", value="Odoo", extraPrice=560 → effective price = salesPrice + extraPrice.
model ProductVariant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @db.Uuid
  attribute  String
  value      String
  extraPrice Decimal  @default(0) @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]

  @@unique([productId, attribute, value])
  @@map("product_variants")
}

model Plan {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  price           Decimal       @db.Decimal(12, 2)
  billingPeriod   BillingPeriod
  /// Bill every N periods (1 = every month, 3 = quarterly when MONTHLY…).
  billingInterval Int           @default(1)
  minQuantity     Int           @default(1)
  /// Availability window for selling this plan.
  availableFrom   DateTime      @db.Date
  availableUntil  DateTime?     @db.Date
  // Per-plan lifecycle switches (admin decides plan by plan)
  autoCloseOnEnd  Boolean       @default(false)
  allowEarlyClose Boolean       @default(false)
  allowPause      Boolean       @default(false)
  allowRenewal    Boolean       @default(true)
  isActive        Boolean       @default(true)
  deletedAt       DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]
  templates     QuotationTemplate[]

  @@index([isActive, deletedAt])
  @@map("plans")
}

model PaymentTerm {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique // "Due on receipt", "Net 15", "Net 30"
  /// Days after invoice issue date that payment is due.
  dueDays   Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("payment_terms")
}

model QuotationTemplate {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  planId       String    @db.Uuid
  /// Quotes created from this template stay valid this many days.
  validityDays Int       @default(30)
  notes        String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  plan          Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]

  @@index([planId])
  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String  @db.Uuid
  productId  String  @db.Uuid
  variantId  String? @db.Uuid
  quantity   Int     @default(1)
  sortOrder  Int     @default(0)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@map("quotation_template_lines")
}

// ───────────────────────── Discounts ─────────────────────────

model Discount {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  type              DiscountType
  /// Amount (FIXED) or percentage 0–100 (PERCENTAGE).
  value             Decimal       @db.Decimal(12, 2)
  scope             DiscountScope
  minPurchaseAmount Decimal?      @db.Decimal(12, 2)
  minQuantity       Int?
  startDate         DateTime      @db.Date
  endDate           DateTime?     @db.Date
  /// null = unlimited. Enforced atomically via a guarded UPDATE of usedCount.
  usageLimit        Int?
  usedCount         Int           @default(0)
  isActive          Boolean       @default(true)
  deletedAt         DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  products      DiscountProduct[]
  subscriptions SubscriptionDiscount[]
  redemptions   DiscountRedemption[]

  @@index([scope, isActive, startDate, endDate])
  @@map("discounts")
}

model DiscountProduct {
  discountId String @db.Uuid
  productId  String @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_products")
}

/// Attaches a SUBSCRIPTION-scoped discount to a subscription.
model SubscriptionDiscount {
  subscriptionId String   @db.Uuid
  discountId     String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  discount     Discount     @relation(fields: [discountId], references: [id], onDelete: Restrict)

  @@id([subscriptionId, discountId])
  @@index([discountId])
  @@map("subscription_discounts")
}

/// One row per (discount, invoice) → guarantees a discount is counted once per invoice
/// and gives an auditable usage trail.
model DiscountRedemption {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discountId     String   @db.Uuid
  invoiceId      String   @db.Uuid
  subscriptionId String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  discount     Discount     @relation(fields: [discountId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([discountId, invoiceId])
  @@index([invoiceId])
  @@index([subscriptionId])
  @@map("discount_redemptions")
}

// ───────────────────────── Subscriptions ─────────────────────────

model Subscription {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human number, e.g. SUB-2026-000123 (see DocumentSequence).
  number              String             @unique
  customerId          String             @db.Uuid
  planId              String             @db.Uuid
  paymentTermId       String             @db.Uuid
  quotationTemplateId String?            @db.Uuid
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime           @db.Date
  expiryDate          DateTime?          @db.Date
  /// Quotation stops being acceptable after this date.
  quoteValidUntil     DateTime?          @db.Date
  /// Next date an invoice is due to be generated. null when not billable.
  /// Advanced in the SAME transaction that creates the invoice.
  nextBillingDate     DateTime?          @db.Date
  /// Optimistic locking for concurrent edits / transitions.
  version             Int                @default(1)
  activatedAt         DateTime?          @db.Timestamptz(3)
  pausedAt            DateTime?          @db.Timestamptz(3)
  closedAt            DateTime?          @db.Timestamptz(3)
  closeReason         String?
  notes               String?
  createdById         String?            @db.Uuid
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentTerm       PaymentTerm        @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  quotationTemplate QuotationTemplate? @relation(fields: [quotationTemplateId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lines         SubscriptionLine[]
  discounts     SubscriptionDiscount[]
  invoices      Invoice[]
  statusHistory SubscriptionStatusHistory[]
  redemptions   DiscountRedemption[]

  @@index([customerId])
  @@index([planId])
  @@index([status, nextBillingDate])
  @@index([status, expiryDate])
  @@index([createdAt])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @db.Uuid
  productId      String   @db.Uuid
  variantId      String?  @db.Uuid
  taxId          String?  @db.Uuid
  description    String?
  quantity       Int
  /// Price per unit INCLUDING variant extra, captured when the line is added.
  unitPrice      Decimal  @db.Decimal(12, 2)
  /// quantity × unitPrice (pre-discount, pre-tax). Stored for fast reads; recomputed on write.
  amount         Decimal  @db.Decimal(12, 2)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  tax          Tax?            @relation(fields: [taxId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([productId])
  @@map("subscription_lines")
}

/// Append-only state-transition log ("anyone should see where it stands").
model SubscriptionStatusHistory {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String              @db.Uuid
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  reason         String?
  changedById    String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@map("subscription_status_history")
}

// ───────────────────────── Billing ─────────────────────────

/// Observability for the scheduled billing job.
model BillingRun {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The "as of" date this run billed up to.
  runDate     DateTime         @db.Date
  status      BillingRunStatus @default(RUNNING)
  triggeredBy String? // 'scheduler' | user id
  scanned     Int              @default(0)
  invoiced    Int              @default(0)
  skipped     Int              @default(0)
  failed      Int              @default(0)
  errors      Json?
  startedAt   DateTime         @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime?        @db.Timestamptz(3)

  invoices Invoice[]

  @@index([runDate])
  @@map("billing_runs")
}

/// Exactly one row (id = 1, enforced by a CHECK): the daily scheduler's configuration, edited by admins in the Billing page.
model BillingSettings {
  id               Int      @id @default(1)
  schedulerEnabled Boolean  @default(false)
  /// UTC hour after which the daily run starts (0-23).
  runHourUtc       Int      @default(1)
  /// Scheduled runs confirm (number) invoices immediately instead of leaving drafts for review.
  autoConfirm      Boolean  @default(false)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  updatedById      String?  @db.Uuid

  @@map("billing_settings")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. INV-2026-000456 (see DocumentSequence). Assigned on confirm; null while DRAFT.
  number         String?       @unique
  subscriptionId String        @db.Uuid
  customerId     String        @db.Uuid
  billingRunId   String?       @db.Uuid
  status         InvoiceStatus @default(DRAFT)

  /// The billing period this invoice covers. (subscriptionId, periodStart) is unique among
  /// non-cancelled invoices → a period can never be billed twice (partial unique index).
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  issueDate   DateTime @db.Date
  dueDate     DateTime @db.Date
  currency    String   @default("INR") @db.Char(3)

  subtotal      Decimal @db.Decimal(12, 2) // Σ line amounts, before discount
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  /// Denormalised Σ payments, maintained transactionally with each Payment insert.
  amountPaid    Decimal @default(0) @db.Decimal(12, 2)

  // Customer snapshot at billing time
  billToName    String
  billToEmail   String
  billToAddress Json?
  billToTaxId   String?

  notes       String?
  sentAt      DateTime? @db.Timestamptz(3)
  confirmedAt DateTime? @db.Timestamptz(3)
  paidAt      DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  subscription Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billingRun   BillingRun?          @relation(fields: [billingRunId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]
  redemptions  DiscountRedemption[]

  @@index([status, dueDate]) // overdue list & aging
  @@index([customerId, status])
  @@index([subscriptionId])
  @@index([issueDate])
  @@index([billingRunId])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String  @db.Uuid
  productId      String? @db.Uuid
  variantId      String? @db.Uuid
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  /// Tax rate snapshot (%) so later tax edits never rewrite history.
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  /// quantity × unitPrice − discountAmount + taxAmount
  lineTotal      Decimal @db.Decimal(12, 2)
  sortOrder      Int     @default(0)

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_lines")
}

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String        @db.Uuid
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  paidAt         DateTime      @db.Timestamptz(3)
  /// Bank ref / cheque no. / gateway txn id
  reference      String?
  note           String?
  /// Client-supplied key makes POST /payments safely retryable.
  idempotencyKey String?       @unique
  recordedById   String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paidAt])
  @@index([method, paidAt])
  @@map("payments")
}

// ───────────────────────── Platform ─────────────────────────

/// Gap-tolerant, concurrency-safe document numbering:
///   INSERT … ON CONFLICT (key) DO UPDATE SET lastValue = lastValue + 1 RETURNING lastValue
/// `key` is e.g. "SUB-2026" or "INV-2026".
model DocumentSequence {
  key       String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("document_sequences")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @db.Uuid
  action     String // "invoice.confirm", "discount.create", "user.create"…
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
